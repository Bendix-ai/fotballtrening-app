# Supabase Configuration
# Get these from your Supabase project: Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry Configuration (optional — crash reporting)
# Get this from your Sentry project: Settings → Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# EAS Build — these should be set as EAS Secrets, not in .env
# eas secret:create --name EXPO_PUBLIC_SUPABASE_URL --value "https://..."
# eas secret:create --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "..."
# eas secret:create --name EXPO_PUBLIC_SENTRY_DSN --value "..."
