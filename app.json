{
  "expo": {
    "name": "FotballTrening",
    "slug": "fotballtrening-app",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "fotballtrening",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bendixen.fotballtrening",
      "buildNumber": "3",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "FotballTrening trenger tilgang til kameraet for å ta profilbilde.",
        "NSPhotoLibraryUsageDescription": "FotballTrening trenger tilgang til bildegalleriet for å velge profilbilde."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "package": "com.bendixen.fotballtrening",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "organization": "fotballtrening",
          "project": "fotballtrening-app"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d5bdb949-01bc-48fb-9b3d-5ca0885c3f76"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d5bdb949-01bc-48fb-9b3d-5ca0885c3f76"
    }
  }
}
